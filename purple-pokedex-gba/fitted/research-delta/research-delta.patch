diff --git a/src/bulbasaur_field_notes.c b/src/bulbasaur_field_notes.c
new file mode 100644
index 0000000..1269651
--- /dev/null
+++ b/src/bulbasaur_field_notes.c
@@ -0,0 +1,96 @@
+#include "global.h"
+#include "battle.h"
+#include "battle_anim.h"
+#include "bulbasaur_field_notes.h"
+#include "data.h"
+#include "event_data.h"
+#include "overworld.h"
+#include "pokemon.h"
+#include "constants/items.h"
+#include "constants/map_types.h"
+#include "constants/moves.h"
+#include "constants/species.h"
+#include "constants/vars.h"
+
+static EWRAM_DATA u8 sResearchSteps[PARTY_SIZE] = {0};
+static EWRAM_DATA bool8 sDeltaTrial = FALSE;
+
+static bool8 IsFieldBattle(void)
+{
+    return !(gBattleTypeFlags & (BATTLE_TYPE_LINK | BATTLE_TYPE_RECORDED | BATTLE_TYPE_FRONTIER
+                                 | BATTLE_TYPE_SAFARI | BATTLE_TYPE_WALLY_TUTORIAL));
+}
+
+u16 BulbasaurNotes_GetUnlocks(void)
+{
+    return VarGet(VAR_BULBASAUR_FIELD_NOTES);
+}
+
+void BulbasaurNotes_StartBattle(void)
+{
+    u8 slot;
+    for (slot = 0; slot < PARTY_SIZE; slot++)
+        sResearchSteps[slot] = 0;
+    sDeltaTrial = FALSE;
+}
+
+static void RecordBestProgress(u8 shift, u8 steps)
+{
+    u16 unlocks = BulbasaurNotes_GetUnlocks();
+    if (((unlocks >> shift) & 3) < steps)
+        VarSet(VAR_BULBASAUR_FIELD_NOTES, (unlocks & ~(3 << shift)) | (steps << shift));
+}
+
+void BulbasaurNotes_RecordMove(u8 battler, u16 move)
+{
+    static const u16 sResearchMoves[] = {MOVE_ABSORB, MOVE_GROWTH, MOVE_RAZOR_LEAF};
+    u16 slot;
+
+    if (!IsFieldBattle() || GetBattlerSide(battler) != B_SIDE_PLAYER
+        || gBattleMons[battler].species != SPECIES_BULBASAUR || move >= MOVES_COUNT)
+        return;
+    slot = gBattlerPartyIndexes[battler];
+    if (slot >= PARTY_SIZE || GetMonData(&gPlayerParty[slot], MON_DATA_SPECIES) != SPECIES_BULBASAUR)
+        return;
+
+    if (sResearchSteps[slot] < ARRAY_COUNT(sResearchMoves)
+        && move == sResearchMoves[sResearchSteps[slot]])
+    {
+        sResearchSteps[slot]++;
+        RecordBestProgress(BULBASAUR_NOTES_RESEARCH_PROGRESS_SHIFT, sResearchSteps[slot]);
+        if (sResearchSteps[slot] == ARRAY_COUNT(sResearchMoves))
+            VarSet(VAR_BULBASAUR_FIELD_NOTES, BulbasaurNotes_GetUnlocks() | BULBASAUR_NOTES_RESEARCH);
+    }
+
+    if (gBattleMons[battler].item == ITEM_TOXIC_SLUDGE)
+    {
+        if (GetCurrentMapType() != MAP_TYPE_UNDERGROUND)
+            RecordBestProgress(BULBASAUR_NOTES_DELTA_PROGRESS_SHIFT, 1);
+        else if (gBattleMoves[move].type != TYPE_POISON)
+            RecordBestProgress(BULBASAUR_NOTES_DELTA_PROGRESS_SHIFT, 2);
+        else
+        {
+            RecordBestProgress(BULBASAUR_NOTES_DELTA_PROGRESS_SHIFT, 3);
+            sDeltaTrial = TRUE;
+        }
+    }
+}
+
+void BulbasaurNotes_FinishBattle(void)
+{
+    if (!IsFieldBattle())
+        return;
+    if (sDeltaTrial && gBattleOutcome == B_OUTCOME_WON)
+        VarSet(VAR_BULBASAUR_FIELD_NOTES, BulbasaurNotes_GetUnlocks() | BULBASAUR_NOTES_DELTA);
+    if (gBattleOutcome == B_OUTCOME_CAUGHT
+        && GetMonData(&gEnemyParty[0], MON_DATA_SPECIES) == SPECIES_DELTA_BULBASAUR)
+        VarSet(VAR_BULBASAUR_FIELD_NOTES, BulbasaurNotes_GetUnlocks() | BULBASAUR_NOTES_DELTA_CAUGHT);
+}
+
+bool8 BulbasaurNotes_OfferDeltaEncounter(void)
+{
+    u16 unlocks = BulbasaurNotes_GetUnlocks();
+    return GetCurrentMapType() == MAP_TYPE_UNDERGROUND
+        && (unlocks & BULBASAUR_NOTES_DELTA)
+        && !(unlocks & BULBASAUR_NOTES_DELTA_CAUGHT);
+}
