+static void SwapBulbasaurNotesSprite(u8 taskId, bool8 delta)
+{
+    u16 id;
+    FreeAndDestroyMonPicSprite(gTasks[taskId].tMonSpriteId);
+    id = CreateMonPicSprite_HandleDeoxys(delta ? SPECIES_DELTA_BULBASAUR : SPECIES_BULBASAUR,
+                                        SHINY_ODDS, 0, TRUE, MON_PAGE_X, MON_PAGE_Y, 0, TAG_NONE);
+    gTasks[taskId].tMonSpriteId = id;
+    if (id != 0xFFFF)
+        gSprites[id].oam.priority = 0;
+}
+
+static bool8 HandleBulbasaurNotesInput(u8 taskId)
+{
+    bool8 delta;
+    u8 i;
+    u16 result;
+
+    if (sBulbasaurNotesPartySlot != PARTY_SIZE)
+    {
+        if (JOY_NEW(B_BUTTON))
+        {
+            sBulbasaurNotesPartySlot = PARTY_SIZE;
+            sBulbasaurNotesPrompt = NOTES_PROMPT_NONE;
+        }
+        else if (JOY_NEW(SELECT_BUTTON))
+            sBulbasaurNotesMoveSlot = (sBulbasaurNotesMoveSlot + 1) % MAX_MON_MOVES;
+        else if (JOY_NEW(A_BUTTON))
+        {
+            struct Pokemon *mon = &gPlayerParty[sBulbasaurNotesPartySlot];
+            u8 bonuses = GetMonData(mon, MON_DATA_PP_BONUSES);
+            bonuses &= ~(3 << (2 * sBulbasaurNotesMoveSlot));
+            SetMonData(mon, MON_DATA_PP_BONUSES, &bonuses);
+            SetMonMoveSlot(mon, MOVE_SOLAR_LEAF, sBulbasaurNotesMoveSlot);
+            sBulbasaurNotesPartySlot = PARTY_SIZE;
+            sBulbasaurNotesPrompt = NOTES_PROMPT_LEARNED;
+        }
+        else
+            return TRUE;
+    }
+    else if (JOY_NEW(L_BUTTON) || JOY_NEW(R_BUTTON))
+    {
+        delta = sBulbasaurNotesPage == NOTES_DELTA;
+        sBulbasaurNotesPage = (sBulbasaurNotesPage + (JOY_NEW(R_BUTTON) ? 1 : NOTES_PAGE_COUNT - 1)) % NOTES_PAGE_COUNT;
+        if (delta != (sBulbasaurNotesPage == NOTES_DELTA) && (BulbasaurNotes_GetUnlocks() & BULBASAUR_NOTES_DELTA))
+            SwapBulbasaurNotesSprite(taskId, sBulbasaurNotesPage == NOTES_DELTA);
+        sBulbasaurNotesPrompt = NOTES_PROMPT_NONE;
+        PlaySE(SE_DEX_PAGE);
+    }
+    else if (JOY_NEW(A_BUTTON) && sBulbasaurNotesPage == NOTES_RESEARCH)
+    {
+        if (!(BulbasaurNotes_GetUnlocks() & BULBASAUR_NOTES_RESEARCH))
+        {
+            PlaySE(SE_FAILURE);
+            return TRUE;
+        }
+        sBulbasaurNotesPrompt = NOTES_PROMPT_NO_PARTY;
+        for (i = 0; i < gPlayerPartyCount; i++)
+        {
+            if (GetMonData(&gPlayerParty[i], MON_DATA_SPECIES_OR_EGG) != SPECIES_BULBASAUR)
+                continue;
+            result = GiveMoveToMon(&gPlayerParty[i], MOVE_SOLAR_LEAF);
+            if (result == MON_ALREADY_KNOWS_MOVE)
+            {
+                sBulbasaurNotesPrompt = NOTES_PROMPT_KNOWN;
+                continue;
+            }
+            if (result == MON_HAS_MAX_MOVES)
+            {
+                sBulbasaurNotesPartySlot = i;
+                sBulbasaurNotesMoveSlot = 0;
+            }
+            else
+                sBulbasaurNotesPrompt = NOTES_PROMPT_LEARNED;
+            break;
+        }
+    }
+    else
+        return FALSE;
+
+    RedrawBulbasaurNotes();
+    return TRUE;
+}
