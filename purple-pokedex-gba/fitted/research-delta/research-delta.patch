-                                     sStates[i] == TASK_COMPLETED ? sInk : sMutedInk, TEXT_SKIP_DRAW,
-                                     sStates[i] == TASK_HIDDEN ? sUnknown : sTasks[i]);
+                                     i < completedRows ? sInk : sMutedInk, TEXT_SKIP_DRAW, sTasks[sBulbasaurNotesPage][i]);
+    }
+
+    if (sBulbasaurNotesPartySlot != PARTY_SIZE)
+    {
+        u16 move = GetMonData(&gPlayerParty[sBulbasaurNotesPartySlot], MON_DATA_MOVE1 + sBulbasaurNotesMoveSlot);
+        StringCopy(StringCopy(gStringVar4, sReplace), gMoveNames[move]);
+        AddTextPrinterParameterized4(WIN_INFO, FONT_NARROW, 18, 144, 0, 0, sInk, TEXT_SKIP_DRAW, gStringVar4);
+    }
+    else if (sBulbasaurNotesPage != NOTES_ENCOUNTER)
+        AddTextPrinterParameterized4(WIN_INFO, FONT_NARROW, 18, 144, 0, 0,
+                                     completedRows == 4 ? sInk : sMutedInk, TEXT_SKIP_DRAW, reward);
+    if (reward == sDeltaUnlocked)
+    {
+        u8 glyphX = 18 + GetStringWidth(FONT_NARROW, sDeltaUnlocked, 0) + 3;
+        for (row = 0; row < ARRAY_COUNT(sDeltaGlyph); row++)
+            for (col = 0; col < 4; col++)
+                if (sDeltaGlyph[row] & (1 << (3 - col)))
+                    FillWindowPixelRect(WIN_INFO, PIXEL_FILL(TEXT_DYNAMIC_COLOR_6), glyphX + col, 147 + row, 1, 1);
     }
+    AddTextPrinterParameterized4(WIN_INFO, FONT_NARROW, 174, 144, 0, 0, sMutedInk, TEXT_SKIP_DRAW,
+                                 sBulbasaurNotesPartySlot != PARTY_SIZE ? sCycle : sBrowse);
+}
+
+static void RedrawBulbasaurNotes(void)
+{
+    FillWindowPixelBuffer(WIN_INFO, PIXEL_FILL(0));
+    PrintBulbasaurFieldNotes();
+    CopyWindowToVram(WIN_INFO, COPYWIN_FULL);
 }
 
